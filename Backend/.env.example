# Backend runtime
PORT=5000
MONGO_DB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Razorpay (server-side secrets only)
RAZORPAY_ID=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_key_secret
# Price in INR (e.g. 499.00); backend converts this to paise.
SUBSCRIPTION_PRICE=499.00

# SMTP / email OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_email@gmail.com
SMTP_APP_PASSWORD=your_new_google_app_password
EMAIL_FROM=NewsHub <your_sender_email@gmail.com>

# Comma-separated exact frontend origins; no trailing slash
CORS_ORIGINS=http://localhost:5173

# OTP hashing secret (generate a random value of at least 32 characters)
OTP_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=1h
# Phase 3: JWTs also carry a token version; password resets invalidate old sessions.

# One-time initial administrator provisioning only.
# Add these temporarily to Backend/.env, run `npm run create-admin`,
# then remove these four BOOTSTRAP_ADMIN_* entries.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional values used by Backend/backend.http (keep real values in local .env only)
ADMIN_EMAIL=
ADMIN_PASSWORD=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Payment activation uses MongoDB multi-document transactions.
# Use MongoDB Atlas or a local MongoDB replica set (not standalone mongod).

# Production note: use a shared rate-limit store (for example Redis) when running multiple API instances.
